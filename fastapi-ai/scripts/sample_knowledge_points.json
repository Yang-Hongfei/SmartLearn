{
  "nodes": [
    {"id": "kp_recursion", "name": "递归", "description": "函数直接或间接调用自身来解决问题的编程技巧，核心要素是基准情形和递归体", "difficulty": 2, "category": "算法思想"},
    {"id": "kp_divide_conquer", "name": "分治法", "description": "将原问题分解为若干个规模较小的子问题，递归求解后合并结果", "difficulty": 2, "category": "算法思想"},
    {"id": "kp_dp", "name": "动态规划", "description": "通过把原问题分解为相对简单的子问题，保存子问题的解避免重复计算", "difficulty": 4, "category": "动态规划"},
    {"id": "kp_memoization", "name": "记忆化搜索", "description": "递归过程中缓存已计算的结果，自顶向下的动态规划实现方式", "difficulty": 3, "category": "动态规划"},
    {"id": "kp_greedy", "name": "贪心算法", "description": "每一步选择当前看来最优的决策，期望最终达到全局最优解", "difficulty": 3, "category": "算法思想"},
    {"id": "kp_time_complexity", "name": "时间复杂度", "description": "衡量算法运行时间随输入规模增长的趋势，使用大O表示法", "difficulty": 1, "category": "基础概念"},
    {"id": "kp_space_complexity", "name": "空间复杂度", "description": "衡量算法运行所需额外存储空间随输入规模增长的趋势", "difficulty": 1, "category": "基础概念"},
    {"id": "kp_array", "name": "数组", "description": "连续内存空间中存储相同类型元素的线性数据结构", "difficulty": 1, "category": "数据结构"},
    {"id": "kp_linked_list", "name": "链表", "description": "通过指针链接的节点序列，支持高效的插入和删除操作", "difficulty": 2, "category": "数据结构"},
    {"id": "kp_stack", "name": "栈", "description": "后进先出（LIFO）的线性数据结构", "difficulty": 1, "category": "数据结构"},
    {"id": "kp_queue", "name": "队列", "description": "先进先出（FIFO）的线性数据结构", "difficulty": 1, "category": "数据结构"},
    {"id": "kp_binary_tree", "name": "二叉树", "description": "每个节点最多有两个子节点的树形数据结构", "difficulty": 2, "category": "数据结构"},
    {"id": "kp_bst", "name": "二叉搜索树", "description": "左子树所有节点值小于根节点，右子树所有节点值大于根节点的二叉树", "difficulty": 3, "category": "数据结构"},
    {"id": "kp_heap", "name": "堆", "description": "一种特殊的完全二叉树，满足堆性质（最大堆/最小堆），常用于实现优先队列", "difficulty": 3, "category": "数据结构"},
    {"id": "kp_hash_table", "name": "哈希表", "description": "通过哈希函数将键映射到存储位置的数据结构，支持O(1)平均查找", "difficulty": 2, "category": "数据结构"},
    {"id": "kp_graph", "name": "图", "description": "由顶点和边组成的非线性数据结构，表示多对多关系", "difficulty": 3, "category": "数据结构"},
    {"id": "kp_bfs", "name": "广度优先搜索(BFS)", "description": "从起点逐层向外扩展的图遍历算法，使用队列实现", "difficulty": 2, "category": "搜索"},
    {"id": "kp_dfs", "name": "深度优先搜索(DFS)", "description": "沿一条路径深入到底再回溯的图遍历算法，使用递归或栈实现", "difficulty": 2, "category": "搜索"},
    {"id": "kp_binary_search", "name": "二分查找", "description": "在有序数组中每次排除一半搜索空间的查找算法", "difficulty": 2, "category": "搜索"},
    {"id": "kp_quick_sort", "name": "快速排序", "description": "基于分治思想，选取基准元素将数组分为两部分递归排序", "difficulty": 3, "category": "排序"},
    {"id": "kp_merge_sort", "name": "归并排序", "description": "将数组递归二分为子数组，排序后再合并，稳定O(nlogn)排序", "difficulty": 3, "category": "排序"},
    {"id": "kp_dijkstra", "name": "Dijkstra算法", "description": "求解非负权图中单源最短路径的贪心算法", "difficulty": 3, "category": "图论"},
    {"id": "kp_topological_sort", "name": "拓扑排序", "description": "对有向无环图的所有顶点进行线性排序，使得每条边u→v的起点u都在终点v之前", "difficulty": 3, "category": "图论"},
    {"id": "kp_backtracking", "name": "回溯法", "description": "通过尝试所有可能解并在不满足条件时剪枝的搜索算法", "difficulty": 3, "category": "算法思想"},
    {"id": "kp_sliding_window", "name": "滑动窗口", "description": "维护一个区间窗口在数组/字符串上滑动，常用于子数组/子串问题", "difficulty": 3, "category": "算法技巧"},
    {"id": "kp_two_pointers", "name": "双指针", "description": "使用两个指针在数组/链表中移动来解决问题，常用于有序数组和链表", "difficulty": 2, "category": "算法技巧"},
    {"id": "kp_prefix_sum", "name": "前缀和", "description": "预处理数组前缀求和，将区间求和查询优化到O(1)时间", "difficulty": 2, "category": "算法技巧"},
    {"id": "kp_knapsack", "name": "背包问题", "description": "经典动态规划问题，在容量限制下选择物品使得总价值最大", "difficulty": 4, "category": "动态规划"},
    {"id": "kp_lcs", "name": "最长公共子序列", "description": "在两个序列中找到最长的共同子序列，经典二维DP问题", "difficulty": 4, "category": "动态规划"},
    {"id": "kp_lis", "name": "最长递增子序列", "description": "在无序数组中找到最长的严格递增子序列", "difficulty": 3, "category": "动态规划"}
  ],
